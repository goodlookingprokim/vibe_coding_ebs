# ==============================================================================
# Vercel 환경 변수 실습 가이드 (.env.example)
# Vercel 대시보드 (Settings > Environment Variables)에 등록할 3개 키-값 예시
# ==============================================================================

# 1. 학교명 / 기관명
SCHOOL_NAME=EBS 디지털 미디어 고등학교

# 2. 상단 배너 실시간 공지사항 문구
NOTICE_MSG=🚀 [Vercel 라이브] 2026 시즌 오픈! 모든 퀘스트를 완료하고 수료증을 발급받으세요.

# 3. 탐험 시즌 / 연도
TOUR_YEAR=2026
